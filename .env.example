# Copy this file to .env for local development against a plain `node server.js`
# (no Netlify context). On Netlify itself, set these as environment variables
# in the Netlify dashboard instead of shipping a .env file — DATABASE_URL is
# not needed there at all once Netlify DB is provisioned (db.js reads the
# connection string Netlify injects automatically).

# postgres://user:password@host:5432/database
DATABASE_URL=postgres://noir:devpass123@localhost:5432/noir

# Required in production (app.js refuses to boot without them there).
# Generate a real one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=noir-dev-secret
# Comma-separated list of the Netlify Identity email(s) allowed to become
# admin after logging in. Must match exactly the email(s) invited to the
# site's Identity instance.
ADMIN_EMAIL=you@example.com

PORT=3000
NODE_ENV=development
