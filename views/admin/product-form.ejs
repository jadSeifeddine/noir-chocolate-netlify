<%- include('partials/header') %>

<a href="/admin/menu" class="back-link">← Back to menu</a>
<div class="page-head" style="margin-top:.5rem;">
  <div>
    <div class="eyebrow"><%= product ? 'Edit' : 'New' %></div>
    <h1><%= product ? 'Edit Product' : 'New Product' %></h1>
  </div>
</div>

<form
  action="<%= product ? '/admin/products/' + product.id : '/admin/products' %>"
  method="POST" enctype="multipart/form-data" class="pcard" style="max-width:820px;">

  <div class="form-grid">
    <div class="full">
      <label for="name">Product Name *</label>
      <input id="name" name="name" value="<%= product ? product.name : '' %>" required />
    </div>

    <div>
      <label for="price">Price (USD) *</label>
      <input id="price" name="price" type="number" step="0.01" min="0" value="<%= product ? product.price : '' %>" required />
    </div>

    <div>
      <label for="category_id">Category</label>
      <select id="category_id" name="category_id">
        <option value="">— None —</option>
        <% cats.forEach(c => { %>
          <option value="<%= c.id %>" <%= product && product.category_id === c.id ? 'selected' : '' %>><%= c.name %></option>
        <% }) %>
      </select>
    </div>

    <div class="full">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="3"><%= product ? product.description : '' %></textarea>
    </div>

    <div class="full">
      <label>Sizes / Options <span class="muted" style="text-transform:none; letter-spacing:0;">— optional, leave empty to sell at the single price above</span></label>
      <div id="variantRows">
        <% (product && product.variants ? product.variants : []).forEach(v => { %>
          <div class="variant-row">
            <input type="text" name="variant_label" placeholder="e.g. 18 pieces" value="<%= v.label %>" />
            <input type="number" name="variant_price" step="0.01" min="0" placeholder="Price" value="<%= v.price %>" />
            <button type="button" class="btn-mini danger variant-remove">Remove</button>
          </div>
        <% }) %>
      </div>
      <button type="button" id="addVariant" class="btn btn--ghost btn--sm" style="margin-top:.6rem;">+ Add another size</button>
      <p class="muted" style="font-size:.8rem; margin-top:.5rem;">
        If you add sizes here, customers pick one on the product page instead of using the single price above.
      </p>
    </div>

    <% if (product) { %>
      <div class="full">
        <label>Customer Rating</label>
        <% if (product.rating_count) { %>
          <p style="margin:0;"><%= product.rating.toFixed(1) %> ★ from <%= product.rating_count %> customer review<%= product.rating_count === 1 ? '' : 's' %></p>
        <% } else { %>
          <p class="muted" style="margin:0;">No reviews yet.</p>
        <% } %>
        <p class="muted" style="font-size:.8rem; margin-top:.3rem;">
          Set by customers on the product page — not editable here.
        </p>
      </div>
    <% } %>

    <div class="full">
      <label for="image">Product Image <%= product ? '(leave empty to keep current)' : '' %></label>
      <input id="image" name="image" type="file" accept="image/jpeg,image/png,image/webp" />
      <p class="muted" style="font-size:.8rem; margin-top:.4rem;">
        JPG, PNG or WEBP. It'll be automatically cropped to a square tile, same as every other product.
      </p>
      <div style="margin-top:.8rem; display:flex; align-items:center; gap:1rem;">
        <div id="imgPreviewBox" style="width:100px; height:100px; border-radius:6px; border:1px solid var(--line); overflow:hidden; background:var(--cream); flex:0 0 auto;">
          <% if (product && product.image) { %>
            <img id="imgPreview" src="<%= product.image %>" alt="" style="width:100%; height:100%; object-fit:cover;" />
          <% } else { %>
            <img id="imgPreview" style="width:100%; height:100%; object-fit:cover; display:none;" alt="" />
          <% } %>
        </div>
        <span id="imgPreviewLabel" class="muted" style="font-size:.85rem;"><%= product && product.image ? 'Current image' : 'No image selected' %></span>
      </div>
    </div>
  </div>

  <div class="check-row">
    <label><input type="checkbox" name="featured" value="1" <%= product && product.featured ? 'checked' : '' %> /> House favourite (show on home)</label>
    <label><input type="checkbox" name="available" value="1" <%= !product || product.available ? 'checked' : '' %> /> Available for order</label>
  </div>

  <button type="submit" class="btn btn--solid" style="margin-top:1.8rem;"><%= product ? 'Save Changes' : 'Create Product' %></button>
</form>

<script>
  // Instant square preview, mimicking the server's fixed-crop so what she sees
  // here is what the storefront tile will look like.
  document.getElementById('image').addEventListener('change', (e) => {
    const file = e.target.files[0];
    const img = document.getElementById('imgPreview');
    const label = document.getElementById('imgPreviewLabel');
    if (!file) return;
    img.src = URL.createObjectURL(file);
    img.style.display = 'block';
    label.textContent = 'New photo (preview, will be cropped to a square)';
  });

  // Variant rows: add a blank one, or remove any existing one. No reason to
  // reload the page for either.
  document.getElementById('addVariant').addEventListener('click', () => {
    const row = document.createElement('div');
    row.className = 'variant-row';
    row.innerHTML = `
      <input type="text" name="variant_label" placeholder="e.g. 18 pieces" />
      <input type="number" name="variant_price" step="0.01" min="0" placeholder="Price" />
      <button type="button" class="btn-mini danger variant-remove">Remove</button>
    `;
    document.getElementById('variantRows').appendChild(row);
  });
  document.getElementById('variantRows').addEventListener('click', (e) => {
    if (e.target.classList.contains('variant-remove')) e.target.closest('.variant-row').remove();
  });
</script>

<%- include('partials/footer') %>
